package editor

import (
	"github.com/invopop/icons"
	popui "github.com/invopop/popui.go"
	"github.com/invopop/popui.go/props"
	"path"
)

templ Page() {
	@popui.App(props.App{
		Title: "GOBL Editor",
		Importmap: []props.Import{
			{Name: "codemirror", URL: "https://esm.sh/codemirror@6.0.1"},
			{Name: "@codemirror/state", URL: "https://esm.sh/@codemirror/state@6"},
			{Name: "@codemirror/lang-xml", URL: "https://esm.sh/@codemirror/lang-xml@6"},
			{Name: "codemirror-json-schema", URL: "https://esm.sh/@invopop/codemirror-json-schema@0.9.3"},
			{Name: "@fsegurai/codemirror-theme-vscode-light", URL: "https://esm.sh/@fsegurai/codemirror-theme-vscode-light@6"},
			{Name: "@fsegurai/codemirror-theme-vscode-dark", URL: "https://esm.sh/@fsegurai/codemirror-theme-vscode-dark@6"},
		},
		Modules: []props.Module{
			{Src: path.Join(AssetPath, popui.Versioned(editorAssets, "editor.js"))},
		},
		Stylesheets: []props.Link{
			{Href: path.Join(AssetPath, popui.Versioned(editorAssets, "editor.css"))},
		},
		Scripts: []props.Script{
			{Src: path.Join(AssetPath, popui.Versioned(editorAssets, "editor-data.js"))},
		},
		Head: headExtras(),
		Data: "editor",
	}) {
		@popui.Header(props.Header{
			Title: goblTitle(),
		}) {
			@modeTabs()
			@darkModeToggle()
		}
		@popui.Main() {
			<div id="errors" x-show="error" x-cloak class="border-b border-border px-4 py-2 text-sm overflow-y-auto max-h-[200px] shrink-0">
				<details open>
					<summary class="cursor-pointer text-red-600 font-semibold" x-text="error?.message || 'Error'"></summary>
					<template x-if="error?.faults?.length">
						<div>
							<template x-for="f in error.faults" :key="f.message + f.paths?.join()">
								<div class="fault">
									<span class="code" x-show="f.code" x-text="'[' + f.code + ']'"></span>
									<span class="path" x-text="f.paths?.join(', ') || ''"></span>
									<span class="msg" x-text="f.message"></span>
								</div>
							</template>
						</div>
					</template>
				</details>
			</div>
			<div id="editor-container" class="flex min-h-0">
				<div class="pane flex-1 min-w-0 flex flex-col">
					@sourceToolbar()
					<div id="source-gobl" class="pane-body">
						@editorSkeleton()
					</div>
				</div>
				<div class="pane flex-1 min-w-0 flex flex-col border-l border-border" x-show="mode === 'convert'" x-cloak>
					@inputToolbar()
					<div id="source-xml" class="pane-body"></div>
				</div>
			</div>
		}
	}
}

// modeTabs switches between building GOBL documents and converting them to
// and from the formats registered with GOBL's convert package.
templ modeTabs() {
	@popui.Tabs(props.Tabs{Variant: "pill", Class: "mb-0 w-auto"}) {
		for _, m := range []struct{ Key, Label string }{{"build", "Build"}, {"convert", "Convert"}} {
			@popui.Tab(props.Tab{
				Variant: "pill",
				Attributes: templ.Attributes{
					"@click":         "setMode('" + m.Key + "')",
					":data-state":    "mode === '" + m.Key + "' ? 'active' : ''",
					":aria-selected": "mode === '" + m.Key + "'",
				},
			}) {
				{ m.Label }
			}
		}
	}
}

// sourceToolbar sits above the GOBL editor: the example picker, and either
// the build options or the format to export into.
templ sourceToolbar() {
	<div class="pane-toolbar">
		<span class="pane-name">GOBL</span>
		<select
			aria-label="Example"
			x-model="exampleID"
			@change="loadExample(exampleID)"
			class="toolbar-select"
		>
			<option value="" disabled>Examples…</option>
			for _, ex := range examples() {
				<option value={ ex.ID }>{ ex.Region } · { ex.Label }</option>
			}
		</select>
		<div class="ml-auto flex items-center gap-2">
			@doneFlash("source")
			<template x-if="mode === 'build'">
				<div class="flex items-center gap-2">
					@popui.Button(props.Button{
						Attributes: templ.Attributes{
							"@click": "envelop = !envelop",
						},
					}) {
						@popui.Checkbox(props.Checkbox{
							Attributes: templ.Attributes{
								"x-model":        "envelop",
								"@click.stop":    "",
								"tabindex":       "-1",
								"pointer-events": "none",
							},
							Class: "pointer-events-none",
						})
						Envelop
					}
					@popui.Button(props.Button{
						Variant: props.ButtonVariantPrimary,
						Attributes: templ.Attributes{
							"@click":    "run('build')",
							":disabled": "loading",
							"title":     "Build (⌘/Ctrl+Enter)",
						},
					}) {
						Build
					}
				</div>
			</template>
			<template x-if="mode === 'convert'">
				<div class="flex items-center gap-2">
					@formatPicker()
					@popui.Button(props.Button{
						Variant: props.ButtonVariantPrimary,
						Attributes: templ.Attributes{
							"@click":    "run('export')",
							":disabled": "loading || !format",
							"title":     "Export the GOBL document into the format (⌘/Ctrl+Enter)",
						},
					}) {
						Export →
					}
				</div>
			</template>
		</div>
	</div>
}

// inputToolbar sits above the editor for documents in other formats: the
// import action, and samples made by exporting the examples into a format
// they can be imported back from.
templ inputToolbar() {
	<div class="pane-toolbar">
		@popui.Button(props.Button{
			Variant: props.ButtonVariantPrimary,
			Attributes: templ.Attributes{
				"@click":    "run('import')",
				":disabled": "loading",
				"title":     "Import the document into GOBL (⌘/Ctrl+Enter)",
			},
		}) {
			← Import
		}
		@doneFlash("input")
		<span class="pane-name truncate" x-text="inputTitle || 'Other format'"></span>
		<select
			aria-label="Sample"
			x-model="sampleID"
			@change="loadSample(sampleID)"
			class="toolbar-select ml-auto"
		>
			<option value="" disabled>Samples…</option>
			for _, ex := range examples() {
				if ex.Sample != "" {
					<option value={ ex.ID }>{ ex.Region } · { ex.Label }</option>
				}
			}
		</select>
	</div>
}

// formatPicker selects the format to export into, from those registered with
// GOBL's convert package that accept the document.
templ formatPicker() {
	<select
		aria-label="Format"
		x-model="format"
		:disabled="!available.length"
		class="toolbar-select"
	>
		<template x-if="!available.length">
			<option value="" x-text="checking ? 'Checking formats…' : 'No formats accept this document'"></option>
		</template>
		<template x-for="f in available" :key="f.key">
			<option :value="f.key" :selected="f.key === format" x-text="f.label"></option>
		</template>
	</select>
}

// doneFlash briefly confirms the last action that updated the pane.
templ doneFlash(pane string) {
	<template x-if={ "done.pane === '" + pane + "' && done.n > 0" }>
		@popui.FlashMessage(props.FlashMessage{
			Type:    "success",
			Message: "Done",
			Attributes: templ.Attributes{
				":key": "done.n",
			},
		})
	</template>
}

templ editorSkeleton() {
	<div class="flex h-full animate-pulse">
		<div class="w-12 border-r border-border bg-muted/30 flex flex-col items-end gap-1 pt-1 pr-2">
			for i := range 20 {
				if i < 15 {
					<div class="h-4 w-4 rounded bg-muted"></div>
				}
			}
		</div>
		<div class="flex-1 flex flex-col gap-1 p-1 pl-4">
			<div class="h-4 w-64 rounded bg-muted"></div>
			<div class="h-4 w-32 rounded bg-muted"></div>
			<div class="h-4 w-48 rounded bg-muted"></div>
			<div class="h-4 w-40 rounded bg-muted ml-4"></div>
			<div class="h-4 w-56 rounded bg-muted ml-8"></div>
			<div class="h-4 w-36 rounded bg-muted ml-4"></div>
			<div class="h-4 w-44 rounded bg-muted ml-4"></div>
			<div class="h-4 w-52 rounded bg-muted ml-8"></div>
			<div class="h-4 w-28 rounded bg-muted ml-8"></div>
			<div class="h-4 w-40 rounded bg-muted ml-4"></div>
			<div class="h-4 w-32 rounded bg-muted"></div>
			<div class="h-4 w-48 rounded bg-muted ml-4"></div>
			<div class="h-4 w-60 rounded bg-muted ml-8"></div>
			<div class="h-4 w-36 rounded bg-muted ml-4"></div>
			<div class="h-4 w-24 rounded bg-muted"></div>
		</div>
	</div>
}

templ headExtras() {
	<link rel="icon" href="/favicon.svg" type="image/svg+xml"/>
	<script>
		if (localStorage.getItem("dark-mode") === "true") {
			document.documentElement.classList.add("dark");
		}
		// Resolved by editor.js with its editors once CodeMirror is mounted.
		// The module loads after alpine:init may have fired, so the editor
		// component waits on this promise.
		window._cmReady = new Promise((r) => { window._cmReadyResolve = r; });
	</script>
	@templ.JSONScript("editor-bootstrap", bootstrap())
}

templ darkModeToggle() {
	<button
		x-data="darkModeToggle"
		@click="toggle"
		class="flex items-center justify-center size-8 -mr-2 rounded-lg text-icon-default-secondary hover:text-icon hover:bg-background-default-secondary transition-colors cursor-pointer"
		title="Toggle dark mode"
	>
		<div
			class="transition-transform duration-300"
			:class="{ 'rotate-180': dark }"
		>
			@icons.Theme()
		</div>
	</button>
}

templ goblTitle() {
	<div class="flex items-center gap-2">
		@icons.Gobl()
		GOBL Editor
	</div>
}
